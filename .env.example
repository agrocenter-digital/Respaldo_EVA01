# =============================================================================
# AgroCenter Digital V1 - variables para docker compose
# Copiar a .env y ajustar si es necesario:  cp .env.example .env
# =============================================================================

# Puertos expuestos en el host
FRONTEND_PORT=3000
BFF_PORT=8080
MS_INVENTARIO_PORT=8081
MS_VENTAS_PORT=8082
MS_COMPRAS_PORT=8083
DB_INVENTARIO_PORT=5434
DB_VENTAS_PORT=5435
DB_COMPRAS_PORT=5436

# PostgreSQL (una instancia por microservicio)
POSTGRES_USER=agrocenter
POSTGRES_PASSWORD=agrocenter

# Perfil de Spring. En EC2 con Cognito usar `prod`; en local `dev`.
SPRING_PROFILES_ACTIVE=dev

# JWT de desarrollo compartido por BFF y microservicios (perfil `dev`).
# Debe tener al menos 32 caracteres. NO se embebe en el frontend de producción.
DEV_JWT_SECRET=agrocenter-local-dev-secret-please-change-32b
DEV_JWT_ISSUER=http://localhost:8081/dev-issuer

# AWS Cognito (perfil `prod`). El BFF solo acepta access tokens (token_use=access).
COGNITO_ISSUER_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_DBCBjL67J
COGNITO_JWK_SET_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_DBCBjL67J/.well-known/jwks.json
COGNITO_AUDIENCE=agrocenter-api

# CORS del BFF. Incluye el frontend de Vercel y ambas EC2 para handoffs.
ALLOWED_ORIGINS=https://front-web-seven.vercel.app,http://44.195.118.58:3000,http://34.195.64.174:3000,http://localhost:3000,http://localhost,http://127.0.0.1:3000,http://127.0.0.1
ALLOWED_ORIGIN_PATTERNS=https://*.vercel.app

# Vacío para usar rutas relativas y el proxy de Nginx hacia bff-web.
# Si se define, el frontend llamará directamente a esa URL (requiere CORS).
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_SITE_URL=http://44.195.118.58:3000

# Cognito en el panel (el flujo normal es handoff desde el sitio principal).
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=

# Fallback de JWT SOLO para desarrollo local. En producción debe quedar vacío.
NEXT_PUBLIC_DEV_JWT_FALLBACK_TOKEN=

# Memoria de la JVM
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
