2# =============================================================================
# AgroCenter Digital - variables para docker compose
# Copiar a .env y ajustar si es necesario:  cp .env.example .env
# =============================================================================

# Puertos expuestos en el host
FRONTEND_PORT=3000
BFF_PORT=8080
MS_INVENTARIO_PORT=8081
MS_VENTAS_PORT=8082
MS_COMPRAS_PORT=8083
DB_INVENTARIO_PORT=5434
DB_VENTAS_PORT=5435
DB_COMPRAS_PORT=5436

# PostgreSQL (una instancia por microservicio)
POSTGRES_USER=agrocenter
POSTGRES_PASSWORD=agrocenter

# JWT de desarrollo compartido por BFF y microservicios (perfil `dev`).
# Debe tener al menos 32 caracteres.
# IMPORTANTE: si cambias este secreto, regenera el token de desarrollo
# embebido en front-web/lib/cognito.ts.
DEV_JWT_SECRET=agrocenter-local-dev-secret-please-change-32b
DEV_JWT_ISSUER=http://localhost:8081/dev-issuer
COGNITO_AUDIENCE=agrocenter-api

# Vacío para usar rutas relativas y el proxy de Nginx hacia bff-web.
# Si se define, el frontend llamará directamente a esa URL (requiere CORS).
NEXT_PUBLIC_API_BASE_URL=

# Memoria de la JVM
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
